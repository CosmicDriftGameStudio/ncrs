str ::= "\"" [^"\\\x7F\x00-\x1F]{1,80} "\""
year ::= [12] [0-9]{3}
amount ::= [0-9]{1,7} ("." [0-9]{1,2})?
sched ::= "\"once\"" | "\"always\""
xfer ::= "\"copy\"" | "\"move\""
order ::= "\"by_month\"" | "\"by_year\"" | "\"by_sender\"" | "\"by_kind\"" | "\"flat\""
qk ::= "\"sum\"" | "\"deadline\"" | "\"number\"" | "\"date\""
tidy ::= "{\"intent\":\"tidy_folder\",\"source\":" str (",\"target\":" str)? (",\"schedule\":" sched)? (",\"transfer\":" xfer)? "}"
change ::= "{\"intent\":\"change_structure\",\"area\":" str (",\"scope\":" str)? ",\"order\":" order "}"
undo ::= "{\"intent\":\"undo\"}"
yfrom ::= ",\"year_from\":" year
yto ::= ",\"year_to\":" year
amin ::= ",\"amount_min\":" amount
amax ::= ",\"amount_max\":" amount
search ::= "{\"intent\":\"search\"" (",\"sender\":" str)? (",\"kind\":" str)? yfrom? yto? amin? amax? (",\"text\":" str)? "}"
ask ::= "{\"intent\":\"ask_content\",\"question_kind\":" qk (",\"sender\":" str)? (",\"kind\":" str)? "}"
explain ::= "{\"intent\":\"explain\",\"file\":" str "}"
bulk ::= "{\"intent\":\"bulk_move\"" (",\"filter_kind\":" str)? (",\"filter_sender\":" str)? (",\"filter_year\":" year)? ",\"target\":" str "}"
other ::= "{\"intent\":\"other\"}"
